# Example environment configuration for the recipe_backend

# Database URL (SQLAlchemy format)
# For SQLite (default): sqlite:///./recipes.db
# For Postgres: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///./recipes.db

# Secret key for JWT signing - replace in production
SECRET_KEY=change-me-in-production

# Token expiration in minutes (e.g., 60 minutes = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins (e.g., http://localhost:3000,https://example.com)
CORS_ORIGINS=*
